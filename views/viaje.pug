extends ./layout/index

block contenido
    main(class="container mt-5")
        div(class="row")
            div(class="col-md-5")
                img(src=`/img/destinos_${resultadoViaje.imagen}_ln.jpg`, alt="imagen viaje" class="img-fluid")
            div(class="col-md-7")
                h1 #{resultadoViaje.titulo}     
                div(class="d-flex align-items-center mb-2")
                      
                    svg(xmlns='http://www.w3.org/2000/svg', width='50', height='50', viewBox='0 0 24 24', fill='none', stroke='#d13b2e', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
                        path(d='M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12')
                        path(d='M16 3v4')
                        path(d='M8 3v4')
                        path(d='M4 11h16')
                        path(d='M7 14h.013')
                        path(d='M10.01 14h.005')
                        path(d='M13.01 14h.005')
                        path(d='M16.015 14h.005')
                        path(d='M13.015 17h.005')
                        path(d='M7.01 17h.005')
                        path(d='M10.01 17h.005')
                    p(class="m-0")
                        | #{resultadoViaje.fecha_ida} - #{resultadoViaje.fecha_vuelta}
                div(class="d-flex align-items-center")
                    svg(xmlns='http://www.w3.org/2000/svg', width='60', height='60', viewBox='0 0 24 24', fill='none', stroke='#d13b2e', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
                        path(d='M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0')
                        path(d='M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2')
                    p(class="m-0")
                        | #{resultadoViaje.disponible}   
                    p(class="m-0") 
                        | #{resultadoViaje.descripcion.substr(0,100) + "..."}