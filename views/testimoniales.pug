extends ./layout/index

block contenido
    main(class="container mt-5")
        div(class="row")
            include ./layout/testimoniales
            div(class="col-md-12")
                h2(class="d-block w-100 text-center") Agregar un testimonial
                if(errores)
                    each error in errores 
                        .alert.alert-danger.text-center=error.mensaje

            div(class="row justify-content-center col")
                div(class="col-md-8")
                    form(action="/testimoniales" method="POST")
                        div(class="form-group")
                            label(for="nombre") Nombre
                            input(type="text" id="nombre" name="nombre" class="form-control" placeholder="Ingresa tu nombre") 
                        div(class="form-group")
                            label(for="correo") Correo Electronico
                            input(type="text" id="correo" name="correo" class="form-control" placeholder="Ingresa tu correo")
                        div(class="form-group")
                            label(for="mensaje") Mensaje
                            textarea( id="mensaje" name="mensaje" row="24" class="form-control" placeholder="Escreibe un mensaje...") 
                        input(type="submit" class="btn btn-success d-block w-100")
      
